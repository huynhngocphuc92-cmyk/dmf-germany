{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmf-talents",
  "account_id": "cd2355b1655a8bf991ab9faaa0d14d5f",
  "main": "custom-worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.dmf-talents.de",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ratelimits": [
    {
      "name": "DMF_RL_CHAT",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "DMF_RL_CONTACT",
      "namespace_id": "2002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "DMF_RL_API",
      "namespace_id": "2003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DMF_TALENTS_ANALYTICS",
      "dataset": "dmf_talents_telemetry"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dmf-talents"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "dmf-talents-next-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "UNSUBSCRIBES_KV",
      "id": "dc467c8b3c3e463fb2df061e8869274f"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://www.dmf-talents.de",
    "NEXT_PUBLIC_DEBUG_MODE": "false",
    "NEXT_PUBLIC_SENTRY_ENABLE_REPLAY": "false",
    "NOTIFICATION_DELIVERY": "enabled",
    "SMTP_HOST": "smtp.resend.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "resend",
    "SMTP_FROM": "contact@dmf-talents.de",
    "CONTACT_EMAIL": "contact@dmf-talents.de",
    "OPENROUTER_PRIMARY_MODEL": "deepseek/deepseek-v4.1-flash-1017",
    "OPENROUTER_FREE_FALLBACK_MODEL": "google/gemma-4-26b-a4b-it:free",
    "OPENROUTER_PAID_BACKUP_MODEL": "google/gemma-4-26b-a4b-it",
    "GEMINI_MODEL": "gemini-3.1-flash-lite-preview",
    "NEXT_PUBLIC_SUPABASE_URL": "https://iihprcuhmilmymlbktpy.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_xYIoiJIgepiCQDa2d4tOjw_5voIT82e",
    "NEXT_PUBLIC_GA_ID": "G-0P6ECEDSWG",
    "SENTRY_ORG": "dmf-ys",
    "SENTRY_PROJECT": "dmf-germany",
    "CF_ACCOUNT_ID": "cd2355b1655a8bf991ab9faaa0d14d5f",
    "CF_AI_GATEWAY_ACCOUNT_ID": "cd2355b1655a8bf991ab9faaa0d14d5f",
    "CF_AI_GATEWAY_ID": "dmf-ai-gateway",
    "NEXT_PUBLIC_MEDIA_BASE_URL": "https://media.dmf-talents.de",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGJ1Ao5DQXrcFM7U",
    "TURNSTILE_HOSTNAMES": "www.dmf-talents.de,dmf-talents.de"
  }
}
