# --- SUPABASE CONFIG ---
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- APP CONFIG ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG_MODE=false

# --- EMAIL SERVICES (SMTP) ---
# Used for Nodemailer in API routes (Gmail or Hosting)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
CONTACT_EMAIL=contact@dmf-germany.de

# --- OPTIONAL: TELEGRAM NOTIFICATIONS ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GOOGLE ANALYTICS ---
NEXT_PUBLIC_GA_ID=G-H5QF4BKTEW

# --- OPTIONAL: SENTRY ---
# Replay stays disabled unless you explicitly opt in and use an EU DSN host (*.de.sentry.io).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLE_REPLAY=false

# --- AI CHATBOT (Gemini API) ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
