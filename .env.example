# Copy to .env.local for local development. Use a dedicated test Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never use a NEXT_PUBLIC_ prefix. One of these is required for intake.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Trusted admins are provisioned through Supabase app_metadata.role="admin".

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG_MODE=false
# Preview writes require a separate test database and this opt-in.
# The production project is explicitly blocked from preview writes.
INTAKE_TEST_BACKEND=false
# Local delivery is disabled by default. Only enable with agreed test recipients.
# Vercel Preview always disables external notifications; Production uses configured channels.
NOTIFICATION_DELIVERY=disabled

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI features
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
GEMINI_API_KEY=
# Optional monitoring; no production IDs in local/CI defaults.
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLE_REPLAY=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
